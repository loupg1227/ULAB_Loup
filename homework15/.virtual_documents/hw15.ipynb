





import numpy as np
import matplotlib.pyplot as plt
import matplotlib.animation as animation

x = np.linspace(0, 2 * np.pi, 100)
y = np.sin(x)

fig, ax = plt.subplots()
line, = ax.plot(x, np.sin(x))
def update(frame):
    line.set_ydata(np.sin(x +frame /10.0))
    return line,

ani = animation.FuncAnimation(fig, update, frames = 100 , interval = 25, blit = False)
plt.show()



# If we increase the frames per second, then the animation should move faster.





ani.save("a.gif", writer = "pillow", fps = 40)





# blit = False redraws the entire figure we want to animate at every frame (making it run slower) while blit = true only redraws the changed parts
# of the figure. 








r = 2 # radius of circle
def circle(phi):
    return np.array([r*np.cos(phi), r*np.sin(phi)])

fig, ax = plt.subplots()
ax.axis([-5,5,-5,5])
# create a point in the axes
point, = ax.plot(0,1, marker="o")

# Updating function, to be repeatedly called by the animation
def update(phi):
    x,y = circle(phi)
    point.set_data([x],[y])
    return point,


ani2 = animation.FuncAnimation(fig, update, interval=10, blit=True, repeat=True,
                    frames=np.linspace(0,2*np.pi,360, endpoint=False))

plt.show()


ani2.save("a4.gif", writer = "pillow", fps = 40)





G = 6.67 * (10 ** (-11))
Ms = 2 * (10**30)
Me = 5.9 * (10**24)
Mm = 6.4 * (10**23)
Mc = 6.39 * (10**20)
AU = 1.49 * (10**15)
daysec = 24 * 3600





earth_aphelion_velocity = 29.3 * (10**3)
mars_aphelion_velocity = 24.07 * (10**3)
comet_velocity = 7000





gravity_constant_earth = (G*Ms*Me)/(1.0167*AU)
gravity_constant_mars = (G*Ms*Mm)/(1.666*AU)
gravity_constant_comet = (G*Ms*Mc)/(2*AU)





xe, ye, ze = 1.0167 * AU, 0, 0
xm, ym, zm = 1.666 * AU, 0, 0
xc, yc, zc = 2 * AU, 0.3 * AU, 0
xs, ys, zs = 0, 0, 0





xve, yve, zve = 0, e_ap_v, 0
xvm, yvm, zvm = 0, m_ap_v, 0
xvc, yvc, zvc = 0, commet_v, 0





xvs, yvs, zvs = 0, 0, 0





t = 0
dt = 1 * daysec
years = 5
sim_years = years * 365 * daysec





xelist = []
yelist = []

xmlist = []
ymlist = []

xclist = []
yclist = []

xslist = []
yslist = []





t = 0

while t < sim_years:
    
    ################ Earth #############
    rx, ry, rz = xe - xs, ye - ys, ze - zs
    modr3_e = (rx**2 + ry**2 + rz**2)**1.5
    fx_e = -gravity_constant_earth * rx / modr3_e
    fy_e = -gravity_constant_earth * ry / modr3_e

    
    xve += fx_e * dt / Me
    yve += fy_e * dt / Me
    xe += xve * dt
    ye += yve * dt    
    xelist.append(xe)
    yelist.append(ye)

    ################ Mars ##############
    rx_m, ry_m, rz_m = xm - xs, ym - ys, zm - zs
    modr3_m = (rx_m**2 + ry_m**2 + rz_m**2)**1.5
    fx_m = -gravity_constant_mars * rx_m / modr3_m
    fy_m = -gravity_constant_mars * ry_m / modr3_m
        
    xvm += fx_m * dt / Mm
    yvm += fy_m * dt / Mm
    xm += xvm * dt
    ym += yvm * dt
        
    xmlist.append(xm)
    ymlist.append(ym)

    ################ Comet ##############
    rx_c, ry_c, rz_c = xc - xs, yc - ys, zc - zs
    modr3_c = (rx_c**2 + ry_c**2 + rz_c**2)**1.5
    fx_c = -gravity_constant_comet * rx_c / modr3_c
    fy_c = -gravity_constant_comet * ry_c / modr3_c
        
    xvc += fx_c * dt / Mc
    yvc += fy_c * dt / Mc
    xc += xvc * dt
    yc += yvc * dt
        
    xclist.append(xc)
    yclist.append(yc)

    ################ Sun ##############
    xvs += -(fx_e + fx_m) * dt / Ms
    yvs += -(fy_e + fy_m) * dt / Ms
    xs += xvs * dt
    ys += yvs * dt
    xslist.append(xs)
    yslist.append(ys)
    
    t += dt





plt.figure(figsize=(8, 8))
plt.scatter(xelist, yelist, label="Earth", color = "blue")
plt.scatter(xmlist, ymlist, label="Mars", color = "red")
plt.scatter(xclist, yclist, label="Comet", color = "grey")
plt.scatter(xslist, yslist, label="Sun", color = "yellow")
plt.xlabel("X Position (m)")
plt.ylabel("Y Position (m)")
plt.title("Orbital Simulation of Earth, Mars, Comet, and Sun")
plt.legend()
plt.grid(True)
plt.show()





fig, ax = plt.subplots(figsize=(8, 8))
ax.set_xlim(-3 * AU, 3 * AU)
ax.set_ylim(-3 * AU, 3 * AU)
ax.set_aspect('equal')
ax.set_xlabel("X Position (m)")
ax.set_ylabel("Y Position (m)")
ax.set_title("Orbital Simulation of Earth, Mars, Comet, and Sun")

line_e, = ax.plot([], [], '-g', lw=1, label="Earth Orbit")
line_m, = ax.plot([], [], '-r', lw=1, label="Mars Orbit")
line_c, = ax.plot([], [], '-b', lw=1, label="Comet Orbit")
line_s, = ax.plot([], [], 'yo', markersize=4, label="Sun")  # Sun is stationary

point_e, = ax.plot([], [], 'go', markersize=6)
point_m, = ax.plot([], [], 'ro', markersize=6)
point_c, = ax.plot([], [], 'bo', markersize=6)

# Text labels
text_e = ax.text(0, 0, 'Earth', fontsize=12, color='green')
text_m = ax.text(0, 0, 'Mars', fontsize=12, color='red')
text_c = ax.text(0, 0, 'Comet', fontsize=12, color='blue')

# Update function for animation
def update(frame):

    print(f"Frame {frame}: xelist={xelist[frame]}, yelist={yelist[frame]}")
    print(f"Frame {frame}: xmlist={xmlist[frame]}, ymlist={ymlist[frame]}")
    print(f"Frame {frame}: xclist={xclist[frame]}, yclist={yclist[frame]}")
    
    line_e.set_data(xelist[:frame], yelist[:frame])
    point_e.set_data(xelist[frame], yelist[frame])
    text_e.set_position((xelist[frame], yelist[frame]))

    line_m.set_data(xmlist[:frame], ymlist[:frame])
    point_m.set_data(xmlist[frame], ymlist[frame])
    text_m.set_position((xmlist[frame], ymlist[frame]))

    line_c.set_data(xclist[:frame], yclist[:frame])
    point_c.set_data(xclist[frame], yclist[frame])
    text_c.set_position((xclist[frame], yclist[frame]))

    line_s.set_data(xslist[:frame], yslist[:frame])

    return line_e, point_e, text_e, line_m, point_m, text_m, line_c, point_c, text_c, line_s,
    
# Create the animation\n",
ani = animation.FuncAnimation(fig, update, frames=len(xelist), repeat=True,interval=1, blit=True),

# Show the plot with the animation\n",
plt.legend()
plt.grid(True)
plt.show()



